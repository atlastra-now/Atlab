---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { url } from '../utils/url';
import { readingMinutes } from '../utils/reading-time';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort((a, b) => b.data.date.localeCompare(a.data.date));
const [lead, ...rest] = articles;
const withTime = (a: (typeof articles)[number]) => ({ article: a, minutes: readingMinutes(a.body ?? '') });
// 站点简介由作者提供，没有提供前不显示。
const tagline = '';
---
<BaseLayout title="Product Lab" description={lead ? lead.data.dek : 'Product Lab'} current="home">
  <main class="home pad">
    <div class="full">
      {tagline && <p class="tagline">{tagline}</p>}
      {lead && (
        <a class="feat" href={url(`articles/${lead.id}/`)}>
          <div class="cover">
            <Image src={lead.data.cover} alt={lead.data.coverAlt} widths={[800, 1200]} sizes="(min-width: 900px) 780px, 100vw" loading="eager" />
          </div>
          <div class="txt">
            <span class="kind">{lead.data.kind} {String(lead.data.issue).padStart(2, '0')} · <span class="sub">{lead.data.topic}</span></span>
            <h2>{lead.data.title}</h2>
            <p>{lead.data.dek}</p>
            <p class="meta">{lead.data.kind} · 约 {withTime(lead).minutes} 分钟</p>
          </div>
        </a>
      )}
      {rest.length > 0 && (
        <ul class="cards">
          {rest.map((a) => <ArticleCard {...withTime(a)} />)}
        </ul>
      )}
      {articles.length >= 4 && (
        <ol class="index">
          {articles.map((a, i) => (
            <li><a href={url(`articles/${a.id}/`)}><span class="n">{String(i + 1).padStart(2, '0')}</span><span class="t">{a.data.title}</span><span class="c">{a.data.kind}</span><span class="d">{a.data.date.slice(0, 4)}</span></a></li>
          ))}
        </ol>
      )}
    </div>
  </main>
</BaseLayout>

<style>
  .home { padding-block: var(--s-40) 0; }
  .tagline { font-size: 16px; line-height: 28px; color: var(--ink-2); margin-bottom: var(--s-32); }
  .feat { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--gutter); align-items: end; }
  .cover { grid-column: 1 / 9; aspect-ratio: 16 / 10; background: var(--wash); border-radius: 3px; overflow: hidden; }
  .cover :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 0%; }
  .txt { grid-column: 9 / 13; padding-bottom: var(--s-4); }
  h2 { font-size: var(--t-feature); line-height: var(--t-feature-lh); font-weight: 700; letter-spacing: -0.02em; margin-top: 14px; text-wrap: balance; }
  .txt p:not(.meta) { font-size: 16px; line-height: 28px; color: var(--ink-2); margin-top: var(--s-12); }
  .meta { margin-top: var(--s-16); }
  .feat:hover h2 { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; }
  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-40) var(--gutter); margin-top: var(--s-56); padding-top: var(--s-40); border-top: 1px solid var(--line); }
  .index { margin-top: var(--s-56); border-top: 1px solid var(--ink); }
  .index a { display: grid; grid-template-columns: 72px minmax(0, 1fr) 160px 80px; gap: var(--gutter); padding-block: var(--s-16); border-bottom: 1px solid var(--line); font-size: 16px; line-height: 24px; align-items: baseline; }
  .index .n { font-size: 13px; font-weight: 700; }
  .index .t { font-weight: 500; }
  .index .c, .index .d { font-size: 13px; color: var(--muted); }
  .index .d { text-align: right; }
  @media (max-width: 900px) {
    .cover, .txt { grid-column: 1 / 13; }
    .cards { grid-template-columns: 1fr 1fr; }
    .index a { grid-template-columns: 48px minmax(0, 1fr) 72px; }
    .index .c { display: none; }
  }
  @media (max-width: 620px) { .cards { grid-template-columns: 1fr; } }
</style>
