---
// 真实截图图组。只在有真实截图的位置使用；没有截图的位置保持参考页的灰色占位（.shot），不用本组件。
// 图注两行：第一行读者应该看到什么，第二行观察 + 比较范围（格式与参考页 `.cap` 一致）。
import { Image, getImage } from 'astro:assets';
import { evidence } from '../utils/evidence';

type Item = {
  src: ImageMetadata;
  alt: string;
  product?: 'spotify' | 'qq';
  label?: string;
  context?: string;
  crop?: string;
  ratio?: string;
  focus?: number;
  emphasis?: boolean;
  light?: boolean;
};
export interface Props {
  n: number;
  layout: 'single' | 'pair' | 'before-after' | 'row';
  width?: 'read' | 'wide';
  items: Item[];
  what: string;
  note?: string;
}
const { n, layout, items, what, note } = Astro.props;
const wide = layout !== 'single';
const productName = { spotify: 'Spotify', qq: 'QQ 音乐' };
const dotClass = { spotify: 'sp', qq: 'qq' };
const letters = ['a', 'b', 'c', 'd', 'e'];
const full = await Promise.all(items.map((it) => getImage({ src: it.src, width: Math.min(1200, it.src.width), format: 'webp', quality: 82 })));
const pos = (c?: string) => (c === 'top' ? '50% 0%' : c === 'bottom' ? '50% 100%' : (c ?? '50% 0%'));
---
<figure class:list={['fg', `L-${layout}`, wide ? 'wide' : 'read']}>
  {layout === 'before-after' ? (
    <div class="ba">
      <div class="ba-full">
        {items[0].product && <p class="tag"><i class={`dot ${dotClass[items[0].product]}`}></i>{productName[items[0].product]}{items[0].context && <span>{items[0].context}</span>}</p>}
        <div class:list={['shot', { light: items[0].light }]} style={`aspect-ratio:${items[0].ratio ?? '9/16'}`}>
          <Image src={items[0].src} alt={items[0].alt} widths={[380, 760]} sizes="(min-width: 760px) 380px, 40vw" format="webp" quality={82} loading="lazy" decoding="async" style={`object-position:${pos(items[0].crop)}`} data-full={full[0].src} data-focus={items[0].focus} />
        </div>
      </div>
      <ol class="moments">
        {items.slice(1).map((it, i) => (
          <li>
            <p class="mh"><span>{letters[i]}</span>{it.label}{it.context && <em>{it.context}</em>}</p>
            <div class:list={['shot', { light: it.light, emphasis: it.emphasis }]} style={`aspect-ratio:${it.ratio ?? '3'}`}>
              <Image src={it.src} alt={it.alt} widths={[560, 1120]} sizes="(min-width: 760px) 560px, 100vw" format="webp" quality={82} loading="lazy" decoding="async" style={`object-position:${pos(it.crop)}`} data-full={full[i + 1].src} data-focus={it.focus} />
            </div>
          </li>
        ))}
      </ol>
    </div>
  ) : (
    <div class="items">
      {items.map((it, i) => (
        <div class="item">
          {(it.product || it.label) && (
            <p class="tag">{it.product && <i class={`dot ${dotClass[it.product]}`}></i>}{it.product ? productName[it.product] : it.label}{it.context && <span>{it.context}</span>}</p>
          )}
          <div class:list={['shot', { light: it.light, emphasis: it.emphasis }]} style={`aspect-ratio:${it.ratio ?? '9/16'}`}>
            <Image src={it.src} alt={it.alt} widths={[340, 680]} sizes="340px" format="webp" quality={82} loading="lazy" decoding="async" style={`object-position:${pos(it.crop)}`} data-full={full[i].src} data-focus={it.focus} />
          </div>
        </div>
      ))}
    </div>
  )}
  <figcaption class:list={['cap', 'c4-cap', { read: wide }]}>
    <p class="w"><b>图 {n}</b>{what}</p>
    {note && <p class="n" set:html={evidence(note)} />}
  </figcaption>
</figure>

<style>
  .fg { margin-top: 40px; margin-bottom: 0; }
  .shot img { width: 100%; height: 100%; object-fit: cover; display: block; cursor: zoom-in; }
  .shot img:focus-visible { outline-offset: 2px; }
  .shot.light { box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.07); }
  .shot.emphasis { box-shadow: 0 0 0 2px var(--ink); }
  .tag { font-size: 12px; line-height: 16px; font-weight: 700; margin: 0 0 8px; }
  .tag :global(.dot) { width: 6px; height: 6px; margin-right: 6px; }
  .tag span { font-weight: 400; color: var(--muted); margin-left: 6px; }
  .L-single .item { max-width: 300px; }
  .L-pair .items { display: grid; grid-template-columns: repeat(2, minmax(0, 340px)); gap: 24px; justify-content: center; }
  .L-row .items { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); gap: 16px; }
  .ba { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 6fr); gap: 40px; align-items: start; }
  .moments { display: flex; flex-direction: column; gap: 28px; padding-top: 28px; }
  .mh { font-size: 13px; line-height: 20px; font-weight: 700; margin-bottom: 8px; display: flex; gap: 10px; align-items: baseline; }
  .mh span { display: inline-grid; place-items: center; width: 18px; height: 18px; box-shadow: 0 0 0 1.5px var(--ink); border-radius: 50%; font-size: 11px; line-height: 1; }
  .mh em { font-style: normal; font-weight: 400; color: var(--ink-2); }
  @media (max-width: 900px) {
    .L-row .items { grid-auto-columns: 42%; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 8px; }
    .L-row .item { scroll-snap-align: start; }
  }
  @media (max-width: 760px) {
    .ba { grid-template-columns: 1fr; gap: 24px; }
    .ba-full { max-width: 220px; }
    .moments { padding-top: 0; }
  }
  @media (max-width: 620px) {
    .L-pair .items { gap: 12px; }
  }
</style>

<style is:global>
  .lbx[hidden] { display: none !important; }
  .lbx { position: fixed; inset: 0; z-index: 60; background: rgba(10, 10, 11, 0.95); color: #ededea; display: flex; flex-direction: column; }
  .lbx-bar { display: flex; align-items: center; gap: 12px; padding: calc(env(safe-area-inset-top, 0px) + 12px) max(16px, env(safe-area-inset-right, 0px)) 12px max(16px, env(safe-area-inset-left, 0px)); font-size: 13px; line-height: 20px; border-bottom: 1px solid #2a2a2c; }
  .lbx-t { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .lbx-n { color: #8c8c86; font-variant-numeric: tabular-nums; }
  .lbx button { font: 500 13px var(--sans); color: #ededea; background: none; border: 1px solid #3a3a3d; border-radius: 4px; padding: 4px 10px; min-height: 44px; min-width: 44px; cursor: pointer; }
  .lbx button:disabled { opacity: 0.35; cursor: default; }
  .lbx :focus-visible { outline-color: #ededea; }
  .lbx-scroll { flex: 1; overflow: auto; padding: 24px max(16px, env(safe-area-inset-right, 0px)) calc(env(safe-area-inset-bottom, 0px) + 40px) max(16px, env(safe-area-inset-left, 0px)); }
  .lbx-img { display: block; width: min(560px, 100%); height: auto; margin: 0 auto; border-radius: 4px; }
  .lbx-hint { text-align: center; font-size: 12px; color: #8c8c86; margin-top: 14px; }
</style>

<script>
  import '../scripts/lightbox';
</script>
