---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
export interface Props { src: ImageMetadata; alt: string }
const { src, alt } = Astro.props;
---
<figure class="read cover-fig">
  <Image src={src} alt={alt} widths={[700, 1400]} sizes="(min-width: 760px) 700px, 100vw" loading="eager" />
</figure>
