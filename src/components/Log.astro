---
export interface Props {
  turns: { who: 'user' | 'ai'; label: string; role: string; text: string; note?: string; emphasis?: boolean }[];
  summary: string;
}
const { turns, summary } = Astro.props;
---
<div class="log" role="group" aria-label="一次优化过程的记录">
  {turns.map((t) => (
    <div class={`row ${t.who === 'user' ? 'u' : 'a'}`}>
      <p class="who"><b>{t.label}</b>{t.role}</p>
      <div>
        <span class:list={['say', { turn: t.emphasis }]}>{t.text}</span>
        {t.note && <small>{t.note}</small>}
      </div>
    </div>
  ))}
  <p class="sum">{summary}</p>
</div>
<style>
  .log { margin-top: var(--s-56); }
  .row { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: var(--s-16); padding-block: 18px; border-top: 1px solid var(--line); }
  .who { font-size: 12px; line-height: 18px; color: var(--muted); padding-top: var(--s-8); }
  .who b { display: block; font-weight: 700; color: var(--ink); font-size: 13px; }
  .u .say { font-size: var(--t-quote-l); line-height: var(--t-quote-l-lh); }
  .a .say { font-size: var(--t-quote-m); line-height: var(--t-quote-m-lh); color: var(--ink-2); padding-top: var(--s-4); display: block; }
  .turn { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 8px; text-decoration-color: var(--ink); }
  small { display: block; font-family: var(--sans); font-size: 12px; color: var(--muted); margin-top: 2px; }
  .sum { border-top: 1px solid var(--line); padding-top: var(--s-12); font-size: var(--t-cap2); line-height: var(--t-cap2-lh); color: var(--muted); }
  @media (max-width: 620px) {
    .row { grid-template-columns: 1fr; gap: var(--s-4); }
    .who { padding-top: 0; }
  }
</style>
