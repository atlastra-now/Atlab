---
import Shot from './Shot.astro';
import { evidence } from '../utils/evidence';

type Img = {
  src: ImageMetadata;
  alt: string;
  product: 'spotify' | 'qq';
  label: string;
  weight: number;
  ratio?: string;
  crop?: string;
  light?: boolean;
};
export interface Props {
  prompt: string;
  note: string;
  images: Img[];
  findings: { n: string; href: string; text: string }[];
  n: number;
  what: string;
  captionNote: string;
}
const { prompt, note, images, findings, n, what, captionNote } = Astro.props;
const productName = { spotify: 'Spotify', qq: 'QQ 音乐' };
const cols = ['minmax(0,3.2fr)', ...images.map((i) => `minmax(0,${i.weight}fr)`)].join(' ');
---
<figure class="hero">
  <div class="hf" style={`--cols:${cols}`}>
    <div class="prompt">
      <span class="lbl">研究 Prompt</span>
      <span class="say">「{prompt}」</span>
      <p>{note}</p>
    </div>
    {images.map((im, i) => (
      <div class="cell">
        <span class="tag"><i style={`background:var(--${im.product})`}></i>{productName[im.product]} · {im.label}</span>
        <Shot src={im.src} alt={im.alt} ratio={im.ratio ?? '9/16'} crop={im.crop ?? 'top'} light={im.light} eager={i === 1} sizes="(min-width: 900px) 360px, 33vw" widths={[360, 720]} />
      </div>
    ))}
  </div>
  <figcaption>
    <p class="what"><span class="n">图 {n}</span><span>{what}</span></p>
    <p class="note" set:html={evidence(captionNote)} />
  </figcaption>
</figure>

<div class="contents">
  <p class="lbl">本文的三个发现</p>
  <ol>
    {findings.map((f) => (
      <li><span>{f.n}</span><a href={f.href}>{f.text}</a></li>
    ))}
  </ol>
</div>

<style>
  .hero { max-width: var(--full); margin: var(--s-56) auto 0; }
  .hf { display: grid; grid-template-columns: var(--cols); gap: var(--gutter); align-items: end; }
  .prompt { align-self: start; padding-top: var(--s-8); }
  .lbl { font-size: var(--t-kind); font-weight: 700; letter-spacing: 0.02em; }
  .prompt .say { font-size: var(--t-quote-hero); line-height: var(--t-quote-hero-lh); margin-top: var(--s-12); display: block; }
  .prompt p { font-size: 14px; line-height: 23px; color: var(--ink-2); margin-top: 14px; max-width: 16em; }
  .tag { font-size: var(--t-kind); line-height: var(--t-kind-lh); font-weight: 500; color: var(--ink-2); margin-bottom: var(--s-8); display: block; }
  .tag i { display: inline-block; width: 6px; height: 6px; border-radius: 50%; margin-right: 6px; vertical-align: 1px; }
  figcaption { max-width: var(--read); margin: var(--s-16) auto 0; }
  .what { font-size: var(--t-cap1); line-height: var(--t-cap1-lh); font-weight: 500; }
  .what .n { font-weight: 700; margin-right: 10px; }
  .note { font-size: var(--t-cap2); line-height: var(--t-cap2-lh); color: var(--muted); margin-top: var(--s-4); }
  .note :global(b) { font-weight: 500; color: var(--ink-2); }

  .contents { max-width: var(--read); margin: var(--s-56) auto 0; border-top: 1px solid var(--ink); padding-top: var(--s-16); }
  .contents ol { margin-top: var(--s-12); }
  .contents li { display: grid; grid-template-columns: 56px 1fr; gap: var(--s-8); padding-block: 10px; border-bottom: 1px solid var(--line); font-size: 16px; line-height: 26px; }
  .contents li span { font-weight: 700; font-size: 13px; line-height: 26px; }
  .contents a:hover { text-decoration: underline; text-underline-offset: 4px; }

  @media (max-width: 900px) {
    .hf { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .prompt { grid-column: 1 / -1; margin-bottom: var(--s-12); }
  }
  @media (max-width: 620px) {
    .hf { gap: 10px; }
    .tag { font-size: 11px; }
    .contents li { grid-template-columns: 48px 1fr; }
  }
</style>
