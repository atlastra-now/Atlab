---
// 作者名与联系方式待作者提供（docs/HANDOFF.md §12）。提供之前不渲染任何内容，也不编造。
const { author = '', contact = '' } = Astro.props;
---
{(author || contact) && (
  <footer class="site-foot pad">
    <div class="full">
      {author && <span>{author}</span>}
      {contact && <span>{contact}</span>}
    </div>
  </footer>
)}
