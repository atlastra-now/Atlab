---
import { Image } from 'astro:assets';
import { url } from '../utils/url';
const { article, minutes } = Astro.props;
const d = article.data;
---
<li class="card">
  <a href={url(`articles/${article.id}/`)}>
    <div class="cover"><Image src={d.cover} alt={d.coverAlt} widths={[400, 800]} sizes="(min-width: 900px) 380px, 100vw" loading="lazy" /></div>
    <span class="kind">{d.kind} {String(d.issue).padStart(2, '0')} · <span class="sub">{d.topic}</span></span>
    <h3>{d.title}</h3>
    <p class="dek">{d.dek}</p>
    <p class="meta">约 {minutes} 分钟</p>
  </a>
</li>

<style>
  .cover { aspect-ratio: 4 / 3; background: var(--wash); border-radius: 3px; overflow: hidden; margin-bottom: var(--s-16); }
  .cover :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 0%; }
  h3 { font-size: var(--t-card); line-height: var(--t-card-lh); font-weight: 700; letter-spacing: -0.01em; margin-top: var(--s-8); }
  .dek { font-size: 15px; line-height: 25px; color: var(--ink-2); margin-top: var(--s-8); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .meta { margin-top: var(--s-8); }
  a:hover h3 { text-decoration: underline; text-decoration-thickness: 1.5px; text-underline-offset: 4px; }
</style>
